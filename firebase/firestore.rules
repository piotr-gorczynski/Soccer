rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /tournaments/{tournamentId} {
      // Permit GET and LIST from any authenticated user
      allow get, list: if request.auth != null;

      // (Optional) if you store sub-collections such as
      // /tournaments/{id}/participants/…
      match /{subDoc=**} {
        allow get, list: if request.auth != null;
      }
    }

    function approvedTerms(d) {
      return (d.scope == 'bangladesh' && d.version == 'BD-terms-2026-10-06'
        && ((d.language == 'bn'
        && d.documentUrl == 'https://piotr-gorczynski.com/bangladesh/terms/BD-terms-2026-10-06-bn.html'
        && d.documentSha256 == '7e35810d68cdd8a0115bb526e867a7bd0b584c6b4e37756b47faeddf88caff3d') || (d.language == 'en'
        && d.documentUrl == 'https://piotr-gorczynski.com/bangladesh/terms/BD-terms-2026-10-06.html'
        && d.documentSha256 == 'e77d67d705baec188e277fe8c1cfdcbbad4d061e0581a64e6c884ede8c76ebcc')))
        || (d.scope == 'global' && d.version == 'GLOBAL-terms-2025-07-30'
        && d.documentUrl == 'https://piotr-gorczynski.com/terms/GLOBAL-terms-2025-07-30/' + d.language + '.html'
        && (
(d.language == 'bn' && d.documentSha256 == 'c37145edf58e83edf1e2c2a487ab41f5712bb0c6f68e240882649edf9a419491')
          || (d.language == 'de' && d.documentSha256 == '3f0447b1b9269f69ba3b46d7af2484d9d611e5d030b845a98bb53812f705d958')
          || (d.language == 'en' && d.documentSha256 == '940cb471414a4d0a5e57844e7593cd3b2e61ce78a5169575f3726b09e6d99961')
          || (d.language == 'es' && d.documentSha256 == 'fc6101ee6d363dcec0c06b7bb435ee1cad54385f3e0f169893a21534625ad02e')
          || (d.language == 'fr' && d.documentSha256 == '45d94dd921a0df17c8dcee865b194dc3c2582ddd0c1f12dff4bdbe3b85eba495')
          || (d.language == 'hi' && d.documentSha256 == 'abdecb0a2dcfd45280ac2c3eebaf8b7caaae0a95286866f328f9e4474dc60bd9')
          || (d.language == 'ne' && d.documentSha256 == '6366c7ff60038c609c2c891a57f6e115844d1c1fb17c5ef35e4e25f24c51fd16')
          || (d.language == 'pl' && d.documentSha256 == '3f2c0e60ef535e5783ac221eb9b4f3fc10788d1905fb02036f8a90f19a29409b')
          || (d.language == 'ur' && d.documentSha256 == '99c895f3584bb19aedaccbac5ffddb9cb7ca54c4f3363697e2adc8ad85539289')));
    }

    // 1. Users: anyone signed-in can read any profile,
    //    but only the owner can create or modify their own doc.
    function notBlocked(a, b) {
      return !exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        && !exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }
    match /users/{userId} {
      match /blocks/{blockedUid} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false; // setPlayerBlock derives owner from auth
      }
      allow read: if request.auth.uid != null;

      // Allow a user to create their own profile document,
      // and to update it thereafter (e.g. save FCM token).
      allow create: if request.auth.uid == userId
                    && !request.resource.data.keys()
                         .hasAny(['appVariant', 'appVariants', 'migrationStatus', 'accountDeleted', 'accountDeletedAt']);
      allow update: if request.auth.uid == userId
                    && resource.data.get('accountDeleted', false) != true
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountDeleted', 'accountDeletedAt'])
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['appVariant', 'appVariants', 'migrationStatus', 'accountDeleted', 'accountDeletedAt']);

      // No one else may delete or overwrite another’s profile.
      allow delete: if false;

      // Immutable, owner-only legal evidence. Never infer this from legacy profile flags.
      match /legalAcceptances/{acceptanceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['documentType','scope','version','acceptedAt','language','documentUrl','documentSha256','appVersionCode','appVersionName','flavor'])
          && request.resource.data.keys().hasOnly(['documentType','scope','version','acceptedAt','language','documentUrl','documentSha256','appVersionCode','appVersionName','flavor'])
          && request.resource.data.documentType == 'terms'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.appVersionCode is int && request.resource.data.appVersionCode > 0
          && request.resource.data.appVersionName is string && request.resource.data.appVersionName.size() < 100
          && request.resource.data.flavor is string && request.resource.data.flavor.size() < 100
          && acceptanceId == 'terms_' + request.resource.data.scope + '__' + request.resource.data.version
          && approvedTerms(request.resource.data);
        allow update, delete: if false;
      }

      // Friends subcollection: only owner may read/write
      match /friends/{friendId} {
        allow read, delete: if request.auth.uid == userId;
        allow create, update: if request.auth.uid == userId
          && get(/databases/$(database)/documents/users/$(userId)).data.get('accountDeleted', false) != true
          && get(/databases/$(database)/documents/users/$(friendId)).data.get('accountDeleted', false) != true
            && notBlocked(userId, friendId);
      }
    }

    // 2. Invitations: server-only writes, either party may read
    match /invitations/{invId} {
      // clients may only **read** invitations where they are a party
      allow read: if request.auth != null
               && (request.auth.uid == resource.data.from
                   || request.auth.uid == resource.data.to);
      // all client-side writes are blocked; Cloud Functions use Admin SDK
      allow create, update, delete: if false;
    }

    // 3. Matches: only participants may create/read/update
    /* ── helper ───────────────────────────────────────────── */
    function isSignedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDeleted', false) != true);
    }
    function isMatchPlayer(matchId) {
      return request.auth.uid in [
        get(/databases/$(database)/documents/matches/$(matchId)).data.player0,
        get(/databases/$(database)/documents/matches/$(matchId)).data.player1
      ];
    }

    // -------------------------------------------------------------------
    //  🆕  Tournament matches  /tournaments/{tid}/matches/{mid}
    // -------------------------------------------------------------------
    match /tournaments/{tid}/matches/{matchId} {

      function isParticipant() {
        /*  During create() the document doesn’t exist yet, so fall back to
            request.resource.data while still allowing reads/updates later. */
        return request.auth.uid in [
          (resource != null ? resource.data.player0 : request.resource.data.player0),
          (resource != null ? resource.data.player1 : request.resource.data.player1)
        ];
      }

      // 📝 Create a new match (friendlies or Cloud Function)
      allow create: if isSignedIn()
                 && isParticipant()
                 && request.resource.data.player0 is string
                 && request.resource.data.player1 is string
                    && notBlocked(request.resource.data.player0, request.resource.data.player1);

      /* reads for collection-group queries */
      allow get, list: if isSignedIn();          // anyone logged-in may read

      /* writes still restricted to participants */
      allow delete: if isSignedIn() && isParticipant();
      allow update: if isSignedIn() && isParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['player0', 'player1']);

      // ── moves sub-collection *for nested matches* ─────────────
      match /moves/{moveId} {
        /* The parent match doc lives at a fixed location now, so:
           /tournaments/{tid}/matches/{matchId}                         */
        function parentMatch() {
          return get(
            /databases/$(database)/documents/tournaments/$(tid)/matches/$(matchId)
          ).data;
        }
        function allowedPlayer() {
          return request.auth.uid in [
            parentMatch().player0,
            parentMatch().player1
          ];
        }

        /* reads stay the same */
        allow read  : if isSignedIn() && allowedPlayer();

        /* simple “participant can add” ✅ */
        allow create: if isSignedIn() && allowedPlayer();

        allow update, delete: if false;
      }
    }

    /* ── FRIENDLY matches  /matches/{matchId} ─────────────────── */
    match /matches/{matchId} {

      /* 2️⃣  allow client-side creation of a match document */
      allow create: if isSignedIn() && isMatchPlayer(matchId)
                    && request.resource.data.player0 is string
                    && request.resource.data.player1 is string
                    && notBlocked(request.resource.data.player0, request.resource.data.player1);

      /* reads for collection-group queries */
      allow get, list: if isSignedIn();          // top-level friendlies

      /* writes still restricted to participants */
      allow delete: if isSignedIn() && isMatchPlayer(matchId);
      allow update: if isSignedIn() && isMatchPlayer(matchId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['player0', 'player1']);

      /* ---- moves sub-collection ---- */
      match /moves/{moveId} {
        allow read, write: if isSignedIn() && isMatchPlayer(matchId);
      }
    }

    /* ────────────────────────────────────────────────────────────────
     *  FALLBACK: ANY other collection named "matches" at ANY depth
     *  (catches /foo/bar/matches/{matchId}, etc.)
     *  Read-only for signed-in users so your collectionGroup() never fails.
     * ─────────────────────────────────────────────────────────────── */
    match /{path=**}/matches/{matchId} {
      allow get, list: if isSignedIn();
      // no writes here
    }


    // Regulations: read-only for authenticated users, including language subcollections
    match /regulations/{docId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Language-specific rule documents (e.g. /regulations/{id}/en/rules)
      match /{lang}/{subDoc=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // App configuration settings (e.g. ads frequency)
    match /settings/{docId} {
      // Only allow reads from authenticated users
      allow read: if request.auth != null;
      // No client-side writes permitted
      allow write: if false;
    }

    // Payment audit state is separate from the current recipient's sensitive details.
    match /payments/{paymentId} {
      function ownedEditablePayment(payment) {
        return isSignedIn() && request.auth.uid == payment.userId
          && payment.rank == 1
          && payment.status in ['awaiting_details', 'action_required'];
      }
      function validRecipient(info, payment) {
        let tournament = get(/databases/$(database)/documents/tournaments/$(payment.tournamentId)).data;
        let regulation = get(/databases/$(database)/documents/regulations/$(tournament.regulation)).data;
        return info.keys().hasAll(['firstName', 'lastName', 'walletProvider', 'walletNumber', 'submittedAt'])
          && info.keys().hasOnly(['firstName', 'lastName', 'walletProvider', 'walletNumber', 'submittedAt'])
          && info.firstName is string && info.firstName.size() <= 100
          && info.firstName.matches('.*[^\\s].*')
          && info.lastName is string && info.lastName.size() <= 100
          && info.lastName.matches('.*[^\\s].*')
          && info.walletNumber is string
          && ((info.walletProvider == 'BKASH' && 'bkash' in regulation.prizeRules.payoutMethods
                && info.walletNumber.matches('^01[3-9][0-9]{8}$'))
            || (info.walletProvider == 'ROCKET' && 'rocket' in regulation.prizeRules.payoutMethods
                && info.walletNumber.matches('^01[3-9][0-9]{9}$')))
          && info.submittedAt == request.time;
      }
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if ownedEditablePayment(resource.data)
        && request.resource.data.status == 'ready_for_processing'
        && request.resource.data.recipientDetailsVersion == 2
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['recipientInfo', 'issue'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['recipientInfo', 'recipientDetailsVersion', 'status', 'statusUpdatedAt', 'updatedAt', 'issue'])
        && validRecipient(getAfter(/databases/$(database)/documents/payments/$(paymentId)/private/recipient).data, resource.data);
      allow create, delete: if false;

      match /private/{documentId} {
        allow read: if documentId == 'recipient' && request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/payments/$(paymentId)).data.userId;
        // Both documents must change atomically; a standalone recipient write is denied.
        allow create, update: if documentId == 'recipient'
          && ownedEditablePayment(get(/databases/$(database)/documents/payments/$(paymentId)).data)
          && getAfter(/databases/$(database)/documents/payments/$(paymentId)).data.status == 'ready_for_processing'
          && getAfter(/databases/$(database)/documents/payments/$(paymentId)).data.statusUpdatedAt == request.time
          && getAfter(/databases/$(database)/documents/payments/$(paymentId)).data.recipientDetailsVersion == 2
          && validRecipient(request.resource.data, get(/databases/$(database)/documents/payments/$(paymentId)).data);
        allow delete: if false;
      }
    }

    // Payout support requests are created and administered only by trusted
    // Cloud Functions/Admin SDK. The user may read their own ticket and its
    // conversation, but cannot change its status or support replies directly.
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null
               && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                 && request.auth.uid == get(
                      /databases/$(database)/documents/supportTickets/$(ticketId)
                    ).data.userId;
        allow write: if false;
      }

      match /notificationEvents/{eventId} {
        allow read, write: if false;
      }
    }

    // 4. Everything else denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
