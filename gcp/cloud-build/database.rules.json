{
  "rules": {
    "status": {
      "$uid": {
        ".read"  : "auth != null",          
        ".write" : "auth != null && auth.uid == $uid && data.child('accountDeleted').val() != true && !newData.child('accountDeleted').exists()"
      }
    },

    "connection-stay-awake": {
      ".read"  : "auth != null",
      ".write" : "auth != null"
    },

    ".read"  : false,
    ".write" : false
  }
}